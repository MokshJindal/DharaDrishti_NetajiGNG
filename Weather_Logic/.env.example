# ==============================================================================
# Weather_Logic Configuration Template
# ==============================================================================

# API Base URLs
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
HISTORICAL_API_URL=https://api.open-meteo.com/v1/forecast

# Optional API Key (Open-Meteo free tier requires no key; keep blank unless using paid tier)
WEATHER_API_KEY=

# Default Target Location Coordinates
# Default: Berlin (Lat: 52.52, Lon: 13.41)
DEFAULT_LATITUDE=52.52
DEFAULT_LONGITUDE=13.41
DEFAULT_LOCATION_NAME=Berlin

# Forecast and Historical Configuration
HISTORICAL_DAYS=10
TIMEZONE=auto
REQUEST_TIMEOUT_SECONDS=10
